<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:u="sap.ui.unified"
    xmlns:ui="sap.ui.unified"
    xmlns:f="sap.f" 
    xmlns:layout="sap.ui.layout">
	<ResponsivePopover
		id="myPopoverRoles"
		title="Roles"
        titleAlignment="Center"
		class="sapUiResponsivePadding--header sapUiResponsivePadding--footer"
		placement="Auto"
        contentWidth="20%">

		<content>
            
            <Table width="auto" class="sapFDynamicPageAlignContent" items="{ path : 'localModel>/aRolesXUsuario'}" >

                <columns>

                    <Column hAlign="Center" width="10em" minScreenWidth="Tablet" demandPopin="true" >

                        <Text text="Código"/>

                    </Column>

                    <Column hAlign="Center" width="10em" minScreenWidth="Tablet" demandPopin="true">

                        <Text text="Rol"/>

                    </Column>

                </columns>

                <items>

                    <ColumnListItem>

                        <cells>

                            <Text class="textomain-popover" text="{localModel>codigo}" />
                            <Text class="textomain-popover" text="{localModel>rol}" />
                        
                        </cells>

                    </ColumnListItem>
                    
                </items>

            </Table>                

		</content>

	</ResponsivePopover>

</core:FragmentDefinition>
